# ============================================================
# MIRROR DIMENSION — .gitignore
# ============================================================

# ------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

secrets/
secret/
secrets.*
credentials/
credentials.*
tokens/
*.secret

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.so

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/

lib/
lib64/
parts/
sdist/
var/
wheels/

pip-wheel-metadata/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.coveragerc

# Type checking / linters
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------
# Node.js / JavaScript / TypeScript
# ------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

.nyc_output/

# Build artifacts
dist/
build/
.next/
.nuxt/
.output/
coverage/

# TypeScript
*.tsbuildinfo

# ------------------------------------------------------------
# Frontend / Framework caches
# ------------------------------------------------------------

.vite/
.cache/
.parcel-cache/
.turbo/

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

docker-compose.override.yml

# Local Docker data
.docker/
docker-data/
docker-volumes/

# ------------------------------------------------------------
# Databases / Local persistent data
# ------------------------------------------------------------

*.db
*.sqlite
*.sqlite3

data/
database/
databases/
local-data/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
logs/
log/

# Security / forensic local output
forensics/
evidence_vault/
captures/
pcaps/
snapshots/

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# IDEs / Editors
# ------------------------------------------------------------

.vscode/*
!.vscode/settings.example.json

.idea/
*.iml

*.swp
*.swo
*~

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

tmp/
temp/
.tmp/
.temp/

*.tmp
*.temp
*.bak
*.backup

# ------------------------------------------------------------
# Test artifacts
# ------------------------------------------------------------

test-results/
playwright-report/
blob-report/

# ------------------------------------------------------------
# Generated documentation / artifacts
# ------------------------------------------------------------

*.pdf
*.zip
*.tar
*.tar.gz

# ------------------------------------------------------------
# Local AI / ML artifacts
# ------------------------------------------------------------

models/
model/
checkpoints/
*.bin
*.gguf
*.safetensors

# ------------------------------------------------------------
# OS / development metadata
# ------------------------------------------------------------

*.pid
*.pid.lock
